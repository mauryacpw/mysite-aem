<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Dynamic Two Tabs Dialog"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <Tab1
                        jcr:primaryType="nt:unstructured"
                        jcr:title="General"
                        sling:resourceType="granite/ui/components/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <detailsType
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/foundation/form/select"
                                class="cq-dialog-dropdown-showhide"
                                cq-dialog-dropdown-showhide-target=".detailsType-showhide-target"
                                fieldLabel="Details Type"
                                name="./detailsType">
                                <items jcr:primaryType="nt:unstructured">
                                    <personalDetails
                                        jcr:primaryType="nt:unstructured"
                                        text="Personal Details"
                                        value="personalDetails"/>
                                    <educationalDetails
                                        jcr:primaryType="nt:unstructured"
                                        text="Educational Details"
                                        value="educationalDetails"/>
                                </items>
                            </detailsType>
                        </items>
                    </Tab1>
                    <Tab2
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Details"
                        sling:resourceType="granite/ui/components/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <personalDetailsGrp
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/foundation/container"
                                class="hide detailsType-showhide-target type1"
                                showhidetargetvalue="personalDetails">
                                <items jcr:primaryType="nt:unstructured">
                                    <firstName
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="First Name"
                                        name="./firstName"/>
                                    <lastName
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Last Name"
                                        name="./lastName"/>
                                    <gender
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/radio"
                                        fieldLabel="Gender"
                                        name="./gender">
                                        <items jcr:primaryType="nt:unstructured">
                                            <male
                                                jcr:primaryType="nt:unstructured"
                                                text="Male"
                                                value="male"/>
                                            <female
                                                jcr:primaryType="nt:unstructured"
                                                text="Female"
                                                value="female"/>
                                        </items>
                                    </gender>
                                    <age
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="Age"
                                        name="./age"/>
                                    <dob
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                        displayedFormat="YYYY-MM-DD"
                                        fieldLabel="Date of Birth"
                                        name="./dob"
                                        valueFormat="YYYY-MM-DD"/>
                                    <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathbrowser"
                                        fieldLabel=" Image"
                                        name="./image"
                                        rootPath="/content/dam"/>
                                    <imageAltText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Image Alt Text"
                                        name="./imageAltText"/>
                                    <mobile
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Mobile Number"
                                        name="./mobileNumber"/>
                                    <email
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Email"
                                        name="./email"/>
                                    <preferredContactMode
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/foundation/form/select"
                                        fieldLabel="Preferred Mode of Contact"
                                        name="./contactMode">
                                        <items jcr:primaryType="nt:unstructured">
                                            <email
                                                jcr:primaryType="nt:unstructured"
                                                text="Email"
                                                value="email"/>
                                            <mobile
                                                jcr:primaryType="nt:unstructured"
                                                text="Mobile"
                                                value="mobile"/>
                                        </items>
                                    </preferredContactMode>
                                    <address
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                        fieldLabel="Address"
                                        name="./address"
                                        useFixedInlineToolbar="{Boolean}true"/>
                                    <maritalStatus
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/foundation/form/select"
                                        class="cq-dialog-dropdown-showhide"
                                        cq-dialog-dropdown-showhide-target=".maritalStatus-showhide-target"
                                        fieldLabel="Marital Status"
                                        name="./maritalStatus">
                                        <items jcr:primaryType="nt:unstructured">
                                            <single
                                                jcr:primaryType="nt:unstructured"
                                                text="Single"
                                                value="single"/>
                                            <married
                                                jcr:primaryType="nt:unstructured"
                                                text="Married"
                                                value="married"/>
                                        </items>
                                    </maritalStatus>
                                    <singleGroup
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/foundation/container"
                                        class="hide maritalStatus-showhide-target "
                                        showhidetargetvalue="single">
                                        <items jcr:primaryType="nt:unstructured"/>
                                    </singleGroup>
                                    <marriedGroup
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/foundation/container"
                                        class="hide maritalStatus-showhide-target type2"
                                        showhidetargetvalue="married">
                                        <items jcr:primaryType="nt:unstructured">
                                            <spouseName
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Spouse Name"
                                                name="./spouseName"/>
                                            <spouseAge
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Spouse Age"
                                                max="{Long}120"
                                                min="{Long}0"
                                                name="./spouseAge"/>
                                            <spouseOccupation
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Spouse Occupation"
                                                name="./spouseOccupation"/>
                                        </items>
                                    </marriedGroup>
                                </items>
                            </personalDetailsGrp>
                            <educationalDetailsGrp
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/foundation/container"
                                class="hide detailsType-showhide-target type2"
                                showhidetargetvalue="educationalDetails">
                                <items jcr:primaryType="nt:unstructured">
                                    <collegeName
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="College Name"
                                        name="./collegeName"/>
                                    <percentage
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="Percentage"
                                        name="./percentage"/>
                                    <passedOutDate
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                        displayedFormat="YYYY-MM-DD"
                                        fieldLabel="Passed Out Date"
                                        name="./passedOutDate"
                                        valueFormat="YYYY-MM-DD"/>
                                    <Backlog
                                        granite:class="cq-dialog-checkbox-showhide"
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Backlog"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        fieldLabel="Backlog"
                                        name="./backlog"
                                        text="Backlog"
                                        value="true">
                                        <granite:data
                                            jcr:primaryType="nt:unstructured"
                                            cq-dialog-checkbox-showhide-target=".backlogfield"/>
                                    </Backlog>
                                    <backlogCont
                                        granite:class="backlogfield"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <Number-Of-Backlogs
                                                jcr:primaryType="nt:unstructured"
                                                jcr:title="Number Of Backlogs"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                class="backlog-number-field"
                                                fieldLabel="Number Of Backlogs"
                                                name="./numberOfBacklogs"/>
                                        </items>
                                    </backlogCont>
                                </items>
                            </educationalDetailsGrp>
                        </items>
                    </Tab2>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
